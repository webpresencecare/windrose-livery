{
  "name": "windrose-livery",
  "version": "0.9.7",
  "private": true,
  "description": "Windrose Livery: the Style variations screen, the Site Editor menu item and Style Mermaid.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build admin=./src/admin/index.js editor=./src/editor/index.js mermaid=./src/mermaid/view.js mermaid-block=./src/mermaid-block/index.js light-dark-switch=./src/light-dark-switch/index.js --output-path=build --experimental-modules",
    "postbuild": "node bin/guard-build.mjs",
    "start": "wp-scripts start admin=./src/admin/index.js editor=./src/editor/index.js mermaid=./src/mermaid/view.js mermaid-block=./src/mermaid-block/index.js light-dark-switch=./src/light-dark-switch/index.js --output-path=build --experimental-modules",
    "lint:js": "wp-scripts lint-js src",
    "test:js": "node --no-warnings --test 'tests/js/*.test.mjs'"
  },
  "devDependencies": {
    "@wordpress/scripts": "37.1.0"
  },
  "dependencies": {
    "@wordpress/a11y": "5.1.0",
    "@wordpress/api-fetch": "8.1.0",
    "@wordpress/block-editor": "20.0.0",
    "@wordpress/blocks": "17.1.0",
    "@wordpress/components": "44.0.0",
    "@wordpress/core-data": "9.1.0",
    "@wordpress/data": "11.1.0",
    "@wordpress/dataviews": "22.0.0",
    "@wordpress/editor": "16.1.0",
    "@wordpress/element": "10.1.0",
    "@wordpress/hooks": "5.1.0",
    "@wordpress/i18n": "7.1.0",
    "@wordpress/icons": "20.0.0",
    "@wordpress/interactivity": "8.1.0",
    "@wordpress/notices": "6.1.0",
    "@wordpress/plugins": "8.1.0",
    "@wordpress/url": "5.1.0"
  }
}
