{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "windrose/light-dark-switch",
	"title": "Light and dark switch",
	"category": "theme",
	"description": "A button that lets visitors switch between the style's own colours and its light or dark twins. Shows nothing until the site's light and dark switch is on and its style has twin colours.",
	"keywords": [ "dark mode", "light mode", "colour scheme", "color scheme", "theme" ],
	"textdomain": "windrose-livery",
	"attributes": {
		"showLabel": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [ "maxNestingLevel" ],
	"supports": {
		"html": false,
		"reusable": false,
		"interactivity": true,
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": false,
			"link": false
		}
	},
	"editorScript": "windrose-livery-light-dark-switch",
	"viewScriptModule": "file:../../build/light-dark-switch-view.js",
	"style": "file:./style.css"
}
